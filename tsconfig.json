{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "outDir": "public/assets",
    "rootDir": "src",
    "removeComments": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
